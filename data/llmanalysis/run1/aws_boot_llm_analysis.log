			}
		}
		if (mc->va)
			mc->pa |= ndhal->ndhal_address_map.pci_host_base;
		else
			pr_info("host mem occupied %lld\n", mpset->host_mem_size);
	} else {
		mp = &mpset->mp_device[channel][region];
		if (!mp->gen_pool) {
			pr_err("mempool not initialized\n");
