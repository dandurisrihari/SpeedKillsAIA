                                                                                                                                                                                                                                                                                                                                                          };

                                                                                                                                                                                                                                                                                                                                                          struct neuron_pci_device {
                                                                                                                                                                                                                                                                                                                                                            u64 bar0_pa;
                                                                                                                                                                                                                                                                                                                                                            void* bar0;
                                                                                                                                                                                                                                                                                                                                                            u64 bar0_size;
                                                                                                                                                                                                                                                                                                                                                            u64 bar2_pa;
                                                                                                                                                                                                                                                                                                                                                            void* bar2;
                                                                                                                                                                                                                                                                                                                                                            u64 bar2_size;
                                                                                                                                                                                                                                                                                                                                                            u64 bar4_pa;
                                                                                                                                                                                                                                                                                                                                                            void* bar4;
