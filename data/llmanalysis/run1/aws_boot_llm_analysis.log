                                                                                                                                                                                                                                                                                                                                                          };

                                                                                                                                                                                                                                                                                                                                                          struct ndma_eng {
                                                                                                                                                                                                                                                                                                                                                            mutex lock;
                                                                                                                                                                                                                                                                                                                                                            neuron_device* nd;
                                                                                                                                                                                                                                                                                                                                                            u32 eng_id;
                                                                                                                                                                                                                                                                                                                                                            ndma_queue queues[16];
