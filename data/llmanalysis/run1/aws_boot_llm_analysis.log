                                                                                                                                                                                                                                                                                                                                                            enum device_state;
                                                                                                                                                                                                                                                                                                                                                            neuron_attached_process attached_processes[16];
                                                                                                                                                                                                                                                                                                                                                            void* ncdev;
                                                                                                                                                                                                                                                                                                                                                            neuron_pci_device npdev;
                                                                                                                                                                                                                                                                                                                                                            bool dmar_init_done[8];
                                                                                                                                                                                                                                                                                                                                                            ndma_eng ndma_engine[132];
                                                                                                                                                                                                                                                                                                                                                            mem_chunk* ndma_q_dummy_mc;
                                                                                                                                                                                                                                                                                                                                                            void* fw_io_ctx;
                                                                                                                                                                                                                                                                                                                                                            mempool_set mpset;
                                                                                                                                                                                                                                                                                                                                                            mem_chunk* memset_mc;
                                                                                                                                                                                                                                                                                                                                                            mutex memset_lock;
                                                                                                                                                                                                                                                                                                                                                            neuron_mc_handle_map nmch;
                                                                                                                                                                                                                                                                                                                                                            neuron_datastore datastore;
                                                                                                                                                                                                                                                                                                                                                            neuron_metrics metrics;
                                                                                                                                                                                                                                                                                                                                                            neuron_crwl crwl[8];
                                                                                                                                                                                                                                                                                                                                                            neuron_reset nr;
                                                                                                                                                                                                                                                                                                                                                            neuron_cinit nci[8];
                                                                                                                                                                                                                                                                                                                                                            u64 nc_model_started_count[8];
                                                                                                                                                                                                                                                                                                                                                            nsysfsmetric_metrics sysfs_metrics;
                                                                                                                                                                                                                                                                                                                                                            neuron_log_obj log_obj;
                                                                                                                                                                                                                                                                                                                                                            neuron_hbm_scrub_ctx hbm_scrub_ctx;
                                                                                                                                                                                                                                                                                                                                                          };

