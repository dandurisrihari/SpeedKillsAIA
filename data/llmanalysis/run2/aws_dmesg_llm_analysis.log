                                                                                                                                                                                                                                                                                                                                                                                                                                  /* Structure definitions */
                                                                                                                                                                                                                                                                                                                                                                                                                                  struct ncdev {
                                                                                                                                                                                                                                                                                                                                                                                                                                    int minor;
                                                                                                                                                                                                                                                                                                                                                                                                                                    int open_count;
                                                                                                                                                                                                                                                                                                                                                                                                                                    cdev cdev;
                                                                                                                                                                                                                                                                                                                                                                                                                                    mutex ncdev_lock;
                                                                                                                                                                                                                                                                                                                                                                                                                                    neuron_device* ndev;
                                                                                                                                                                                                                                                                                                                                                                                                                                    device* device;
                                                                                                                                                                                                                                                                                                                                                                                                                                  };

                                                                                                                                                                                                                                                                                                                                                                                                                                  struct cdev {
                                                                                                                                                                                                                                                                                                                                                                                                                                    kobject kobj;
                                                                                                                                                                                                                                                                                                                                                                                                                                    module* owner;
                                                                                                                                                                                                                                                                                                                                                                                                                                    file_operations* ops;
                                                                                                                                                                                                                                                                                                                                                                                                                                    list_head list;
                                                                                                                                                                                                                                                                                                                                                                                                                                    u32 dev;
                                                                                                                                                                                                                                                                                                                                                                                                                                    count;
                                                                                                                                                                                                                                                                                                                                                                                                                                  };

                                                                                                                                                                                                                                                                                                                                                                                                                                  struct kobject {
                                                                                                                                                                                                                                                                                                                                                                                                                                    char ** name;
                                                                                                                                                                                                                                                                                                                                                                                                                                    list_head entry;
                                                                                                                                                                                                                                                                                                                                                                                                                                    kobject* parent;
                                                                                                                                                                                                                                                                                                                                                                                                                                    kset* kset;
                                                                                                                                                                                                                                                                                                                                                                                                                                    kobj_type* ktype;
                                                                                                                                                                                                                                                                                                                                                                                                                                    kernfs_node* sd;
                                                                                                                                                                                                                                                                                                                                                                                                                                    kref kref;
                                                                                                                                                                                                                                                                                                                                                                                                                                    state_initialized : 1;
                                                                                                                                                                                                                                                                                                                                                                                                                                    state_in_sysfs : 1;
                                                                                                                                                                                                                                                                                                                                                                                                                                    state_add_uevent_sent : 1;
                                                                                                                                                                                                                                                                                                                                                                                                                                    state_remove_uevent_sent : 1;
                                                                                                                                                                                                                                                                                                                                                                                                                                    uevent_suppress : 1;
                                                                                                                                                                                                                                                                                                                                                                                                                                  };

                                                                                                                                                                                                                                                                                                                                                                                                                                  struct list_head {
                                                                                                                                                                                                                                                                                                                                                                                                                                    list_head* next;
                                                                                                                                                                                                                                                                                                                                                                                                                                    list_head* prev;
                                                                                                                                                                                                                                                                                                                                                                                                                                  };

                                                                                                                                                                                                                                                                                                                                                                                                                                  struct kset {
                                                                                                                                                                                                                                                                                                                                                                                                                                    list_head list;
                                                                                                                                                                                                                                                                                                                                                                                                                                    spinlock_t list_lock;
                                                                                                                                                                                                                                                                                                                                                                                                                                    kobject kobj;
                                                                                                                                                                                                                                                                                                                                                                                                                                    kset_uevent_ops* uevent_ops;
                                                                                                                                                                                                                                                                                                                                                                                                                                  };

                                                                                                                                                                                                                                                                                                                                                                                                                                  struct kset_uevent_ops {
                                                                                                                                                                                                                                                                                                                                                                                                                                  };

                                                                                                                                                                                                                                                                                                                                                                                                                                  struct kobj_type {
                                                                                                                                                                                                                                                                                                                                                                                                                                    sysfs_ops* sysfs_ops;
                                                                                                                                                                                                                                                                                                                                                                                                                                    attribute_group** default_groups;
                                                                                                                                                                                                                                                                                                                                                                                                                                  };

                                                                                                                                                                                                                                                                                                                                                                                                                                  struct sysfs_ops {
                                                                                                                                                                                                                                                                                                                                                                                                                                  };

                                                                                                                                                                                                                                                                                                                                                                                                                                  struct attribute_group {
                                                                                                                                                                                                                                                                                                                                                                                                                                    char ** name;
                                                                                                                                                                                                                                                                                                                                                                                                                                    attribute** attrs;
                                                                                                                                                                                                                                                                                                                                                                                                                                    bin_attribute** bin_attrs;
                                                                                                                                                                                                                                                                                                                                                                                                                                  };

                                                                                                                                                                                                                                                                                                                                                                                                                                  struct attribute {
                                                                                                                                                                                                                                                                                                                                                                                                                                    char ** name;
                                                                                                                                                                                                                                                                                                                                                                                                                                    unsigned short mode;
                                                                                                                                                                                                                                                                                                                                                                                                                                  };

                                                                                                                                                                                                                                                                                                                                                                                                                                  struct bin_attribute {
                                                                                                                                                                                                                                                                                                                                                                                                                                    attribute attr;
                                                                                                                                                                                                                                                                                                                                                                                                                                    size_t size;
                                                                                                                                                                                                                                                                                                                                                                                                                                    void* private;
                                                                                                                                                                                                                                                                                                                                                                                                                                  };

                                                                                                                                                                                                                                                                                                                                                                                                                                  struct kernfs_node {
                                                                                                                                                                                                                                                                                                                                                                                                                                    atomic_t count;
                                                                                                                                                                                                                                                                                                                                                                                                                                    atomic_t active;
                                                                                                                                                                                                                                                                                                                                                                                                                                    kernfs_node* parent;
