                                                                                                                                                                                                                                                                                                                                                                                                                                    count;
                                                                                                                                                                                                                                                                                                                                                                                                                                  };

                                                                                                                                                                                                                                                                                                                                                                                                                                  struct kobject {
                                                                                                                                                                                                                                                                                                                                                                                                                                    char ** name;
                                                                                                                                                                                                                                                                                                                                                                                                                                    list_head entry;
                                                                                                                                                                                                                                                                                                                                                                                                                                    kobject* parent;
                                                                                                                                                                                                                                                                                                                                                                                                                                    kset* kset;
                                                                                                                                                                                                                                                                                                                                                                                                                                    kobj_type* ktype;
                                                                                                                                                                                                                                                                                                                                                                                                                                    kernfs_node* sd;
                                                                                                                                                                                                                                                                                                                                                                                                                                    kref kref;
                                                                                                                                                                                                                                                                                                                                                                                                                                    state_initialized : 1;
                                                                                                                                                                                                                                                                                                                                                                                                                                    state_in_sysfs : 1;
                                                                                                                                                                                                                                                                                                                                                                                                                                    state_add_uevent_sent : 1;
                                                                                                                                                                                                                                                                                                                                                                                                                                    state_remove_uevent_sent : 1;
                                                                                                                                                                                                                                                                                                                                                                                                                                    uevent_suppress : 1;
                                                                                                                                                                                                                                                                                                                                                                                                                                  };

