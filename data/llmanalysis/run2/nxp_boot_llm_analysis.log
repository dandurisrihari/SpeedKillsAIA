    if (Flag & gcvALLOC_FLAG_CONTIGUOUS) {
        gcmkONERROR_EX(gckVIDMEM_AllocateVirtual(Kernel, Flag, bytes, &node),
                       gcvSTATUS_OUT_OF_MEMORY);
    } else {
        gcmkONERROR(gckVIDMEM_AllocateVirtual(Kernel, Flag, bytes, &node));
