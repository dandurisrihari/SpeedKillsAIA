                         IN gctBOOL Specified, OUT gcuVIDMEM_NODE_PTR *Node)
{
    printk(KERN_INFO "FUNC_ENTRY: Entering function gckVIDMEM_AllocateLinear at %s:%d\n", __FILE__, __LINE__);
