static void unmap_buffer(struct kref *kref)
{
    printk(KERN_INFO "FUNC_ENTRY: Entering function unmap_buffer at %s:%d\n", __FILE__, __LINE__);
    struct hailo_vdma_buffer *buf = container_of(kref, struct hailo_vdma_buffer, kref);

    // If dmabuf - unmap and detatch dmabuf
    if (NULL != buf->dmabuf_info.dmabuf) {
        hailo_unmap_dmabuf(buf);
    } else {
        printk(KERN_INFO "DMA_INSTRUMENT: About to call dma_unmap_sg from function %s at %s:%d\n", __func__, __FILE__, __LINE__);
printk(KERN_INFO "DMA_STACK_START: Stack trace for dma_unmap_sg called from %s\n", __func__);
dump_stack();
printk(KERN_INFO "DMA_STACK_END: End of stack trace for dma_unmap_sg\n");
        if (!buf->is_mmio) {
            dma_unmap_sg(buf->device, buf->sg_table.sgl, buf->sg_table.orig_nents, buf->data_direction);
        }

        clear_sg_table(&buf->sg_table);
    }
    kfree(buf);
}
----------------------------------------

