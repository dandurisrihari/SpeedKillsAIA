                                                                                                                                                                                                                                                                                                                                                            void* task;
                                                                                                                                                                                                                                                                                                                                                          };

                                                                                                                                                                                                                                                                                                                                                          struct neuron_pci_device {
                                                                                                                                                                                                                                                                                                                                                            u64 bar0_pa;
                                                                                                                                                                                                                                                                                                                                                            void* bar0;
                                                                                                                                                                                                                                                                                                                                                            u64 bar0_size;
                                                                                                                                                                                                                                                                                                                                                            u64 bar2_pa;
                                                                                                                                                                                                                                                                                                                                                            void* bar2;
                                                                                                                                                                                                                                                                                                                                                            u64 bar2_size;
                                                                                                                                                                                                                                                                                                                                                            u64 bar4_pa;
                                                                                                                                                                                                                                                                                                                                                            void* bar4;
                                                                                                                                                                                                                                                                                                                                                            u64 bar4_size;
                                                                                                                                                                                                                                                                                                                                                          };

                                                                                                                                                                                                                                                                                                                                                          struct ndma_eng {
                                                                                                                                                                                                                                                                                                                                                            mutex lock;
                                                                                                                                                                                                                                                                                                                                                            neuron_device* nd;
                                                                                                                                                                                                                                                                                                                                                            u32 eng_id;
                                                                                                                                                                                                                                                                                                                                                            ndma_queue queues[16];
