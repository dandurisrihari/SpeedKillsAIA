	} else {
		mp = &mpset->mp_device[channel][region];
		if (!mp->gen_pool) {
			pr_err("mempool not initialized\n");
			ret = -ENOMEM;
			goto exit;
		}

		if (mp->gen_pool_small != NULL && size <= mempool_small_alloc_max) {
			pool = mp->gen_pool_small;
			alt_pool = mp->gen_pool;
		} else {
			pool = mp->gen_pool;
			alt_pool = mp->gen_pool_small;
		}

