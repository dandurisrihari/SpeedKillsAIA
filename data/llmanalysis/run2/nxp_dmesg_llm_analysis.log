        for (i = 0; i < gcvCORE_COUNT; i++) {
            if (device->kernels[i]) {
                status = gckKERNEL_AttachProcess(device->kernels[i], gcvTRUE);

                if (gcmIS_ERROR(status))
                    goto OnError;

                attached = i;
            }
        }

        index = devIndex;
    }

    filp->private_data = data;

    /* Success. */
    gcmkFOOTER_NO();
    return 0;

OnError:
