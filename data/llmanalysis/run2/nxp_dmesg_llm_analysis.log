    gctPOINTER       mutex        = gcvNULL;
    gctINT32         oldValue     = 0;
    gctBOOL          acquired     = gcvFALSE;

    gcmkHEADER_ARG("Handle=%d PrcoessID=%d", Handle, ProcessID);

    gcmkONERROR(gckKERNEL_FindHandleDatbase(Kernel, ProcessID,
