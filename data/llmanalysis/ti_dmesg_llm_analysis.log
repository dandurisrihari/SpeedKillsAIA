dump_stack();
printk(KERN_INFO "DMA_STACK_END: End of stack trace for dma_buf_get\n");
	dma_buf = dma_buf_get(fd);
	if (IS_ERR(dma_buf))
		return PTR_ERR(dma_buf);

	/* Attach as the parent device as it will have the correct DMA ops set */
 printk(KERN_INFO "DMA_INSTRUMENT: About to call dma_buf_attach from function %s at %s:%d\n", __func__, __FILE__, __LINE__);
