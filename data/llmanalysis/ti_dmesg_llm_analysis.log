static int dma_buf_phys_open(struct inode *inode, struct file *file)
{
 printk(KERN_INFO "IOCTL_HANDLER: Function dma_buf_phys_open called at %s:%d\n", __FILE__, __LINE__);
	struct miscdevice *miscdev = file->private_data;
	struct device *dev = miscdev->this_device;
	struct dma_buf_phys_file *priv;

	priv = kzalloc(sizeof(*priv), GFP_KERNEL);
	if (!priv)
		return -ENOMEM;
	priv->dev = dev;
	file->private_data = (void *)priv;

	return 0;
}
----------------------------------------

