        if (bytes == 0) {
            /* Mark heap is not used. */
            memory->sentinel[i].VidMem.next     = gcvNULL;
            memory->sentinel[i].VidMem.prev     = gcvNULL;
            memory->sentinel[i].VidMem.nextFree = gcvNULL;
            memory->sentinel[i].VidMem.prevFree = gcvNULL;
