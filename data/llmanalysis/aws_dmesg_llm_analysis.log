                                                                                                                                                                                                                                                                                                                                                                                                                                  /* Structure definitions */
                                                                                                                                                                                                                                                                                                                                                                                                                                  struct ncdev {
                                                                                                                                                                                                                                                                                                                                                                                                                                    int minor;
                                                                                                                                                                                                                                                                                                                                                                                                                                    int open_count;
                                                                                                                                                                                                                                                                                                                                                                                                                                    cdev cdev;
                                                                                                                                                                                                                                                                                                                                                                                                                                    mutex ncdev_lock;
                                                                                                                                                                                                                                                                                                                                                                                                                                    neuron_device* ndev;
                                                                                                                                                                                                                                                                                                                                                                                                                                    device* device;
                                                                                                                                                                                                                                                                                                                                                                                                                                  };

                                                                                                                                                                                                                                                                                                                                                                                                                                  struct cdev {
                                                                                                                                                                                                                                                                                                                                                                                                                                    kobject kobj;
                                                                                                                                                                                                                                                                                                                                                                                                                                    module* owner;
                                                                                                                                                                                                                                                                                                                                                                                                                                    file_operations* ops;
                                                                                                                                                                                                                                                                                                                                                                                                                                    list_head list;
                                                                                                                                                                                                                                                                                                                                                                                                                                    u32 dev;
                                                                                                                                                                                                                                                                                                                                                                                                                                    count;
                                                                                                                                                                                                                                                                                                                                                                                                                                  };

                                                                                                                                                                                                                                                                                                                                                                                                                                  struct kobject {
                                                                                                                                                                                                                                                                                                                                                                                                                                    char ** name;
                                                                                                                                                                                                                                                                                                                                                                                                                                    list_head entry;
                                                                                                                                                                                                                                                                                                                                                                                                                                    kobject* parent;
                                                                                                                                                                                                                                                                                                                                                                                                                                    kset* kset;
                                                                                                                                                                                                                                                                                                                                                                                                                                    kobj_type* ktype;
                                                                                                                                                                                                                                                                                                                                                                                                                                    kernfs_node* sd;
                                                                                                                                                                                                                                                                                                                                                                                                                                    kref kref;
                                                                                                                                                                                                                                                                                                                                                                                                                                    state_initialized : 1;
