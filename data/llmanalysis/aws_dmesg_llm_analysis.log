/* Structure definitions */
struct ncdev {
    int minor;
    int open_count;
    cdev cdev;
    mutex ncdev_lock;
    neuron_device* ndev;
    device* device;
};

struct cdev {
    kobject kobj;
    module* owner;
    file_operations* ops;
    list_head list;
    u32 dev;
     count;
};

struct kobject {
    char ** name;
    list_head entry;
    kobject* parent;
    kset* kset;
    kobj_type* ktype;
    kernfs_node* sd;
    kref kref;
     state_initialized : 1;
     state_in_sysfs : 1;
     state_add_uevent_sent : 1;
     state_remove_uevent_sent : 1;
     uevent_suppress : 1;
};

struct list_head {
    list_head* next;
    list_head* prev;
};

struct kset {
    list_head list;
    spinlock_t list_lock;
    kobject kobj;
    kset_uevent_ops* uevent_ops;
};

struct kset_uevent_ops {
};

struct kobj_type {
    sysfs_ops* sysfs_ops;
    attribute_group** default_groups;
};

struct sysfs_ops {
};

struct attribute_group {
    char ** name;
    attribute** attrs;
    bin_attribute** bin_attrs;
};

struct attribute {
    char ** name;
    unsigned short mode;
};

struct bin_attribute {
    attribute attr;
    size_t size;
    void* private;
};

struct kernfs_node {
    atomic_t count;
    atomic_t active;
    kernfs_node* parent;
    char ** name;
    rb_node rb;
    void* ns;
     hash;
    void* priv;
    u64 id;
     flags;
    unsigned short mode;
    kernfs_iattrs* iattr;
};

struct rb_node {
     __rb_parent_color;
    rb_node* rb_right;
    rb_node* rb_left;
};

struct kernfs_iattrs {
};

struct kref {
    refcount_t refcount;
};

struct module {
    enum state;
    list_head list;
    char * name;
    module_kobject mkobj;
    module_attribute* modinfo_attrs;
    char ** version;
    char ** srcversion;
    kobject* holders_dir;
    kernel_symbol* syms;
    s32* crcs;
     num_syms;
    mutex param_lock;
    kernel_param* kp;
     num_kp;
     num_gpl_syms;
    kernel_symbol* gpl_syms;
    s32* gpl_crcs;
    bool using_gplonly_symbols;
    bool sig_ok;
    bool async_probe_requested;
     num_exentries;
    exception_table_entry* extable;
    module_layout core_layout;
    module_layout init_layout;
    mod_arch_specific arch;
     taints;
     num_bugs;
    list_head bug_list;
    bug_entry* bug_table;
    mod_kallsyms* kallsyms;
    mod_kallsyms core_kallsyms;
    module_sect_attrs* sect_attrs;
    module_notes_attrs* notes_attrs;
    char ** args;
    void* percpu;
     percpu_size;
    void* noinstr_text_start;
     noinstr_text_size;
     num_tracepoints;
    const int* tracepoints_ptrs;
     num_srcu_structs;
    srcu_struct** srcu_struct_ptrs;
     num_bpf_raw_events;
    bpf_raw_event_map* bpf_raw_events;
     btf_data_size;
    void* btf_data;
    jump_entry* jump_entries;
     num_jump_entries;
     num_trace_bprintk_fmt;
    char *** trace_bprintk_fmt_start;
    trace_event_call** trace_events;
     num_trace_events;
    trace_eval_map** trace_evals;
     num_trace_evals;
     num_ftrace_callsites;
    ** ftrace_callsites;
    void* kprobes_text_start;
     kprobes_text_size;
    ** kprobe_blacklist;
