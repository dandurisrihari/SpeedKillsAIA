	mc->ref_count--;
	if (mc->ref_count > 0) {
		mutex_unlock(&mpset->lock);
		return;
	}

	if (mc->mc_handle != NMCH_INVALID_HANDLE) {
		nmch_handle_free(mpset->nd, mc->mc_handle);
