static bool
gasket_is_coherent_region(const struct gasket_driver_desc *driver_desc,
			  ulong address)
{
    printk(KERN_INFO "FUNC_ENTRY: Entering function gasket_is_coherent_region at %s:%d\n", __FILE__, __LINE__);
