void gasket_free_coherent_memory_all(
	struct gasket_dev *gasket_dev, u64 index)
{
    printk(KERN_INFO "FUNC_ENTRY: Entering function gasket_free_coherent_memory_all at %s:%d\n", __FILE__, __LINE__);
	if (!gasket_dev->page_table[index])
		return;

 printk(KERN_INFO "DMA_INSTRUMENT: About to call dma_free_coherent from function %s at %s:%d\n", __func__, __FILE__, __LINE__);
printk(KERN_INFO "DMA_STACK_START: Stack trace for dma_free_coherent called from %s\n", __func__);
dump_stack();
printk(KERN_INFO "DMA_STACK_END: End of stack trace for dma_free_coherent\n");
	if (gasket_dev->coherent_buffer.length_bytes) {
		dma_free_coherent(gasket_get_device(gasket_dev),
				  gasket_dev->coherent_buffer.length_bytes,
				  gasket_dev->coherent_buffer.virt_base,
				  gasket_dev->coherent_buffer.phys_base);
		gasket_dev->coherent_buffer.length_bytes = 0;
		gasket_dev->coherent_buffer.virt_base = NULL;
		gasket_dev->coherent_buffer.phys_base = 0;
	}

	kfree(gasket_dev->page_table[index]->coherent_pages);
	gasket_dev->page_table[index]->coherent_pages = NULL;
	gasket_dev->page_table[index]->num_coherent_pages = 0;
}
----------------------------------------

