gceSTATUS
gckMCFE_Execute( gckHARDWARE Hardware,
                gctBOOL Priority,
                gctUINT32 ChannelId,
                gctADDRESS Address,
                gctUINT32 Bytes)
{
    gceSTATUS status;
    gctUINT32 regBase;
    gcsMCFE_DESCRIPTOR *desc;
    gckMCFE mcFE = Hardware->mcFE;
    gcsMCFE_CHANNEL *channel = ((void *)0);
    gcsMCFE_RING_BUF *ringBuf = ((void *)0);

    do { ; ; } while (0)
                                                                 ;


    ;

    channel = &mcFE->channels[ChannelId];


    ;

    ringBuf = Priority ? &channel->priRingBuf : &channel->stdRingBuf;





    while (_NextPtr(ringBuf->writePtr) == ringBuf->readPtr) {
        gctUINT32 data;

        regBase = Priority ? 0x02B00 :
                             0x02700;


        gckOS_ReadRegisterEx(Hardware->os, Hardware->kernel, regBase + ChannelId * 4, &data)
                                                                           ;

        ringBuf->readPtr = data;

        if (_NextPtr(ringBuf->writePtr) == ringBuf->readPtr) {
            gckOS_Print("%s: MCFE channel %s-%d ringBuf is full!", __FUNCTION__,
                      Priority ? "Pri" : "Std", ChannelId);

            gckOS_Delay(Hardware->os, 100);
        }
    }


    regBase = Priority ? 0x02A00 :
                         0x02600;




    desc = (gcsMCFE_DESCRIPTOR *)&ringBuf->ringBufLogical[ringBuf->writePtr * 2];
    desc->start = (gctUINT32)Address;
    desc->end = (gctUINT32)Address + Bytes;

    do { } while (0)
                                                                    ;

    do { } while (0)
                                                                       ;

    do { status = gckVIDMEM_NODE_CleanCache(Hardware->kernel, ringBuf->ringBufVideoMem, 0, desc, 8); if (((status) < 0)) { do { } while (0); ; goto OnError; } } while (0)

                                                      ;

    ringBuf->writePtr = _NextPtr(ringBuf->writePtr);

   


                                                       ;




    do { status = gckOS_WriteRegisterEx(Hardware->os, Hardware->kernel, regBase + ChannelId * 4, ringBuf->writePtr); if (((status) < 0)) { do { } while (0); ; goto OnError; } } while (0)

                                                         ;


    do { ; ; } while (0);
    return gcvSTATUS_OK;

OnError:

    do { ; ; } while (0);
    return status;

}

