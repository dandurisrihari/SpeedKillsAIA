# Build directories
src/staticanalysis/build

# virtual environment directories
venv/
env/

# Python environment files
.env
.venv/


# Python cache files
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Backup files created by instrumentation
*.backup

# Ignore all JSON and TXT files
*.json
*.txt

# But keep requirements.txt
!requirements.txt

# Ignore CSV and .text files
*.csv
*.text
*.yaml

# LLM Analysis output files
!data/llmanalysis/*/*
!data/llmanalysis/average_BER.csv
!data/llmanalysis/average_NER.csv
!data/llmanalysis/average_results.csv
!data/llmanalysis/median_BER.csv
!data/llmanalysis/median_NER.csv
!data/llmanalysis/median_results.csv

# Kernel instrumenter output files
!data/instrumentation/*

# ioctl statistics output files
!data/ioctl-stats/*

# structure statistics output files
!data/struct-stats/*

# CodeQL database metadata (baseline-info.json etc.) is required by the CLI
!data/codeql-dbs/**

#  Ignore coverage
.coverage

# ignore test log files
logs/*
tests/**/*.log
