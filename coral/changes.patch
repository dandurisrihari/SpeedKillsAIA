+void KernelMmuMapper::DoVictimMap(gasket_page_table_ioctl_flags buffer_to_map) {
+
+  VLOG(4) << StringPrintf("[Debug Sri] DoVictimMap() : %016" PRIx64 " -> %016" PRIx64
+                          " (%d pages) flags=%08" PRIx32 ".",
+                          buffer_to_map.base.host_address,
+                          buffer_to_map.base.device_address, 1,
+                          buffer_to_map.flags);
+  int ioctl_retval = 0;
+  if (map_flags_supported_) {
+    ioctl_retval = ioctl(fd_, GASKET_IOCTL_MAP_BUFFER_FLAGS, &buffer_to_map);
+    if (ioctl_retval == -EPERM || ioctl_retval == -ENOTTY ||
+        ioctl_retval == -EINVAL) {
+      VLOG(4) << StringPrintf("Failed to map buffer with flags, error %d",
+                              ioctl_retval);
+      // This corresponds to an old kernel which doesn't yet support flags.
+      // Set member variable to fallback to legacy IOCTL and try again.
+      map_flags_supported_ = false;
+    }
+  }
+
+  if (!map_flags_supported_) {
+    ioctl_retval = ioctl(fd_, GASKET_IOCTL_MAP_BUFFER, &buffer_to_map.base);
+  }
+
+  if (ioctl_retval != 0) {
+        StringPrintf("Could not map pages : %d (%d)", fd_, errno);
+  }
+
+  if (map_flags_supported_) {
+    VLOG(4) << StringPrintf("MmuMapper#Map() : %016" PRIx64 " -> %016" PRIx64
+                            " (%ld pages) flags=%08" PRIx32 ".",
+                            buffer_to_map.base.host_address,
+                            buffer_to_map.base.device_address, buffer_to_map.base.size,
+                            buffer_to_map.flags);
+  } else {
+    VLOG(4) << StringPrintf("MmuMapper#Map() : %016" PRIx64 " -> %016" PRIx64
+                            " (%ld pages).",
+                            buffer_to_map.base.host_address,
+                            buffer_to_map.base.device_address, buffer_to_map.base.size);
+  }
+}
+                          
+
 Status KernelMmuMapper::DoMap(const void *buffer, int num_pages,
                               uint64 device_virtual_address,
                               DmaDirection direction) {
@@ -108,7 +152,7 @@ Status KernelMmuMapper::DoMap(const void *buffer, int num_pages,
